#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Assume Breach Labs — immersive console (module-aware core).
#
# Hides Docker. The student "logs in" and drives a lab with plain commands. The
# REAL security tools still run underneath, shown behind a simulated host prompt
# (e.g. "[pc2] $ ping 10.1.1.2"), so students learn the real tools — they just
# never touch `docker`.
#
# The core here is generic. Each module supplies a descriptor file
#   modules/module-NN-*/console.env
# that defines its machines and its commands. Contract for console.env:
#   Vars:  MODULE_NO, MODULE_TITLE, MODULE_SUBTITLE, HOSTS, UP_CHECK
#   Funcs: host_ip <name>       -> prints the machine's IP (or empty)
#          topology             -> prints the network/΄setup diagram
#          module_help          -> prints the module's command list
#          module_dispatch v .. -> handle a module command; return 1 if unknown
#   May call core helpers: on_host, host_container, run, and the C_* colours.
#
# Launched by ./start.sh.  Pick a module with LAB_MODULE=NN, else you get a menu.
# ---------------------------------------------------------------------------
set -uo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOGFILE="$(mktemp -t lab-console.XXXXXX)"

# --- container engine ------------------------------------------------------
# Docker by default. Set CONTAINER_ENGINE=podman to run the labs under Podman —
# rootless Podman in particular, which (unlike Docker) does NOT make everyone who
# can start containers root on the host. See docs/SERVER-DEPLOYMENT.md Part F.
#
# The compose file itself is engine-neutral: it is an OCI-era spec, not a Docker
# artefact, so there is ONE set of labs either way. Only the command differs.
#   docker  -> `docker compose`
#   podman  -> `podman compose` (Podman 4.7+), falling back to `podman-compose`
ENGINE="${CONTAINER_ENGINE:-docker}"
if [ "$ENGINE" = "podman" ] && ! podman compose version >/dev/null 2>&1 \
   && command -v podman-compose >/dev/null 2>&1; then
    COMPOSE=(podman-compose)
else
    COMPOSE=("$ENGINE" compose)
fi
LAB_VERSION="$(head -1 "$PROJECT_ROOT/VERSION" 2>/dev/null | tr -d '\r')"
LAB_VERSION="${LAB_VERSION:-unknown}"

# Real escape characters via $'...' so colours survive heredocs and plain echo
# (a bare '\033' string only works inside printf format strings). No colours
# when stdout isn't a terminal (piped output, CI).
if [ -t 1 ]; then
    C_TITLE=$'\033[1;36m'; C_OK=$'\033[0;32m'; C_WARN=$'\033[1;33m'
    C_ERR=$'\033[0;31m'; C_DIM=$'\033[0;90m'; C_PROMPT=$'\033[1;35m'; NC=$'\033[0m'
else
    C_TITLE=''; C_OK=''; C_WARN=''; C_ERR=''; C_DIM=''; C_PROMPT=''; NC=''
fi

# --- core helpers available to modules ------------------------------------
host_container() { echo "m${MODULE_NO}-$1"; }

# Run a real command on a host, shown behind a simulated host prompt (no docker)
on_host() {
    local host="$1"; shift
    printf "${C_DIM}[%s] \$ %s${NC}\n" "$host" "$*"
    "$ENGINE" exec "$(host_container "$host")" "$@" 2>&1 || true
}
run() { printf "${C_DIM}\$ %s${NC}\n" "$*"; "$@"; }

# --- module discovery / selection -----------------------------------------
descriptor_for() { ls "$PROJECT_ROOT"/modules/module-"$1"-*/console.env 2>/dev/null | head -1; }

list_modules() {
    for f in "$PROJECT_ROOT"/modules/module-*/console.env; do
        [ -f "$f" ] || continue
        local no title
        no="$(sed -n 's/^MODULE_NO=//p' "$f" | tr -d '\"' | head -1)"
        title="$(sed -n 's/^MODULE_TITLE=//p' "$f" | tr -d '\"' | head -1)"
        printf "%s|%s\n" "$no" "$title"
    done | sort
}

choose_module() {
    if [ -n "${LAB_MODULE:-}" ]; then echo "$LAB_MODULE"; return; fi
    local mods; mods="$(list_modules)"
    local count; count="$(printf "%s\n" "$mods" | grep -c '|' || true)"
    if [ "$count" -le 1 ]; then printf "%s\n" "$mods" | cut -d'|' -f1; return; fi
    if [ ! -t 0 ]; then printf "%s\n" "$mods" | head -1 | cut -d'|' -f1; return; fi
    printf "${C_TITLE}Available labs:${NC}\n" >&2
    printf "%s\n" "$mods" | while IFS='|' read -r no title; do
        printf "   ${C_PROMPT}%s${NC}  %s\n" "$no" "$title" >&2
    done
    local pick
    read -r -p "$(printf "Which module? (e.g. 03): ")" pick >&2
    echo "$pick"
}

# --- generic lifecycle -----------------------------------------------------
need_docker() {
    if ! command -v "$ENGINE" >/dev/null 2>&1; then
        if [ "$ENGINE" = "podman" ]; then
            printf "${C_ERR}Podman is not installed.${NC}  https://podman.io/getting-started/installation\n"
        else
            printf "${C_ERR}Docker is not installed.${NC}  https://www.docker.com/products/docker-desktop\n"
        fi
        exit 1
    fi
    if ! "$ENGINE" info >/dev/null 2>&1; then
        if [ "$ENGINE" = "podman" ]; then
            printf "${C_ERR}Podman is not ready.${NC} On macOS/Windows run: podman machine start\n"
        else
            printf "${C_ERR}Docker is not running.${NC} Start Docker Desktop and try again.\n"
        fi
        exit 1
    fi
}

lab_is_up() { [ -n "$("$ENGINE" ps -q --filter "name=${UP_CHECK}" 2>/dev/null)" ]; }

# --- lab pack staleness ----------------------------------------------------
# The MACHINES update themselves — bring_up pulls fresh images from GHCR every
# launch. The PACK does not: docker-compose.yml, this script and VERSION are
# whatever the student unzipped, and nothing here ever rewrites them.
#
# That gap is easy to miss because a stale folder looks perfectly healthy: new
# images, old settings. The settings are where the safety lives — which
# interface the lab ports bind to, whether the module-06 GUI asks for a
# password, whether the attacker machine can reach the outside world. A student
# on an old folder gets none of that and sees nothing wrong.
#
# So: fetch the published VERSION and say something. Deliberately toothless —
# it reads one public file, changes nothing on disk, and stays silent unless it
# is sure. Offline, proxied, or GitHub blocked all end the same way: no warning.
# Set LAB_NO_UPDATE_CHECK=1 to skip the request entirely.
VERSION_URL="https://raw.githubusercontent.com/michael-borck/assume-breach-labs/main/VERSION"

start_version_check() {
    [ -z "${LAB_NO_UPDATE_CHECK:-}" ] || return 0
    REMOTE_VERSION_FILE="$(mktemp -t lab-version.XXXXXX)"
    # Backgrounded so it overlaps the image pull and costs no startup time.
    (
        # Short connect timeout as well as a total one: a campus proxy that
        # blackholes the request (drops it rather than refusing) would otherwise
        # burn the whole budget, and this runs against the clock of the image
        # pull it overlaps.
        if command -v curl >/dev/null 2>&1; then
            curl -fsS --connect-timeout 2 --max-time 4 "$VERSION_URL"
        elif command -v wget >/dev/null 2>&1; then
            wget -qO- --timeout=2 --tries=1 "$VERSION_URL"
        fi
    ) >"$REMOTE_VERSION_FILE" 2>/dev/null &
    VERSION_CHECK_PID=$!
}

report_if_stale() {
    [ -n "${VERSION_CHECK_PID:-}" ] || return 0
    wait "$VERSION_CHECK_PID" 2>/dev/null
    local remote; remote="$(head -1 "$REMOTE_VERSION_FILE" 2>/dev/null | tr -d '\r')"
    rm -f "$REMOTE_VERSION_FILE"

    # Only trust something shaped like our YYYY.MM.DD stamp. Anything else —
    # empty, an error page, a captive portal — means stay quiet.
    case "$remote" in
        [0-9][0-9][0-9][0-9].[0-9][0-9].[0-9][0-9]) ;;
        *) return 0 ;;
    esac

    # No VERSION file at all predates the stamp, so it is always behind. Otherwise
    # compare: the fields are fixed-width and zero-padded, so sorting as plain
    # text orders these correctly. A LOCAL version ahead of the published one is
    # someone working on the repo — not stale, no warning.
    if [ "$LAB_VERSION" != "unknown" ]; then
        [ "$LAB_VERSION" != "$remote" ] || return 0
        [ "$(printf '%s\n%s\n' "$LAB_VERSION" "$remote" | sort | head -1)" = "$LAB_VERSION" ] || return 0
    fi

    printf "\n${C_WARN}  Heads up: this lab pack is out of date${NC}"
    printf "${C_DIM} (yours %s, current %s)${NC}\n" "$LAB_VERSION" "$remote"
    printf "${C_DIM}  The lab machines update themselves, but the lab's SETTINGS do not —\n"
    printf "  they come from this folder. Download the current pack and run that one.${NC}\n"
}

# Pull the published images (all are public on GHCR), falling back to a local
# build only if the pull fails, then start without --build to avoid the legacy
# builder racing when several services share one image tag. Dots while it works.
compose_up() {
    (
        cd "$PROJECT_ROOT"
        { "${COMPOSE[@]}" --profile "module-${MODULE_NO}" pull \
            || "${COMPOSE[@]}" --profile "module-${MODULE_NO}" build; } \
            && "${COMPOSE[@]}" --profile "module-${MODULE_NO}" up -d
    ) >"$LOGFILE" 2>&1 &
    local pid=$!
    while kill -0 "$pid" 2>/dev/null; do printf "."; sleep 1; done
    printf "\n"
    wait "$pid"
}

bring_up() {
    # Always pull + `up -d`, even when the machines are already running. An
    # earlier version returned early on "already running", which meant a
    # container started before a lab was fixed lived on forever: the pull was
    # skipped, so the updated image never arrived and the student kept getting
    # the old lab. `up -d` is cheap when nothing changed, and recreates only the
    # containers whose image actually moved.
    local was_up=""
    if lab_is_up; then
        was_up=1
        printf "${C_DIM}Lab already running — checking for updates...${NC}\n"
    else
        printf "${C_DIM}Connecting to the lab...${NC}\n"; sleep 1
        printf "${C_DIM}Powering on the machines...${NC}\n"
    fi

    compose_up
    local rc=$?

    # Machines created before docker-compose.yml pinned the project name belong
    # to a project named after that copy's folder, so this one can't take them
    # over — Compose stops on a container-name conflict. They're disposable
    # (all lab state is baked into the image), so remove and rebuild them.
    if grep -q "is already in use by container" "$LOGFILE" 2>/dev/null; then
        printf "${C_DIM}Replacing lab machines left over from an older copy...${NC}\n"
        # shellcheck disable=SC2046  # word splitting is what we want here
        "$ENGINE" rm -f $("$ENGINE" ps -aq --filter "name=^m${MODULE_NO}-") >>"$LOGFILE" 2>&1
        compose_up
        rc=$?
    fi

    if [ "$rc" -ne 0 ] || ! lab_is_up; then
        # Offline with the lab already up is survivable — the student just
        # doesn't get updates this session. Anything else is fatal.
        if [ -n "$was_up" ] && lab_is_up; then
            printf "${C_WARN}Couldn't check for updates (no network?) — using the machines already running.${NC}\n"
        else
            printf "${C_ERR}Could not start the lab. Details:${NC}\n"; tail -n 15 "$LOGFILE"; exit 1
        fi
    fi
    printf "${C_OK}Connection established. You are logged in.${NC}\n"
}

banner() {
    printf "${C_TITLE}"
    cat <<EOF

  +===================================================================+
  |          A S S U M E   B R E A C H   —   S E C U R I T Y   L A B   |
  |                                                                   |
  |   ${MODULE_SUBTITLE}
  |   Module ${MODULE_NO}: ${MODULE_TITLE}
  +===================================================================+
EOF
    printf "${NC}"
    # Stamp the lab-pack version on every launch. A student's screenshot then says
    # which copy they're running — the common failure is an old unzipped folder
    # (macOS keeps "...-main 2", "...-main 3" side by side) rather than a broken
    # lab. No VERSION file at all means a copy older than 2026.07.28.
    printf "${C_DIM}  lab pack %s${NC}\n\n" "$LAB_VERSION"
}

# Open a URL in the host's browser (for browser-based modules that set BROWSER_URL)
open_browser() {
    local url="${BROWSER_URL:-}"
    [ -n "$url" ] || { printf "${C_ERR}This module has no browser page.${NC}\n"; return; }
    if [ "${CODESPACES:-}" = "true" ]; then
        printf "${C_OK}Open this forwarded link in your browser (Ctrl/Cmd-click it):${NC}\n  %s\n" "$url"
        return
    fi
    printf "${C_OK}Opening %s${NC}\n" "$url"
    if command -v open >/dev/null 2>&1; then open "$url" >/dev/null 2>&1
    elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url" >/dev/null 2>&1
    else printf "${C_WARN}Couldn't auto-open. Paste this into your browser:${NC} %s\n" "$url"; fi
}

do_connect() {
    local host="${1:-}"
    if ! printf " %s " "$HOSTS" | grep -q " $host "; then
        printf "${C_ERR}unknown host: %s  (try: %s)${NC}\n" "$host" "$HOSTS"; return
    fi
    printf "${C_DIM}Opening a session on %s. Type 'exit' to return to the lab console.${NC}\n" "$host"
    "$ENGINE" exec -it -e "PS1=[$host] \$ " "$(host_container "$host")" bash --norc 2>/dev/null \
        || "$ENGINE" exec -it "$(host_container "$host")" sh
}

# Shell-mode modules (console.env sets SHELL_HOST): instead of the wrapped lab>
# REPL, log the student straight into the workstation container as a real
# interactive shell. They use the real Linux/security tools — which also means an
# AI assistant can help them, because the commands and errors are genuine, not
# invented lab verbs. The welcome banner + themed prompt come from the container
# image (/etc/bash.bashrc), so it feels like logging into a dedicated security
# workstation every time.
enter_shell() {
    local host="$1"
    printf "${C_DIM}Logging in to the %s workstation...${NC}\n\n" "$host"
    "$ENGINE" exec -it "$(host_container "$host")" bash 2>/dev/null \
        || "$ENGINE" exec -it "$(host_container "$host")" sh
    teardown_prompt
}

show_help() {
    module_help
    printf "\n  Always available:\n"
    # macOS bash 3.2 can't parse a multi-line ${VAR:+...} inside a heredoc,
    # so the optional line is a plain if instead.
    if [ -n "${BROWSER_URL:-}" ]; then
        printf "    %sopen%s             open this lab's page in your browser\n" "$C_PROMPT" "$NC"
    fi
    cat <<EOF
    ${C_PROMPT}connect <host>${NC}   open a shell on a machine (${HOSTS})
    ${C_PROMPT}map${NC}              show the setup diagram
    ${C_PROMPT}hosts${NC}            list the machines
    ${C_PROMPT}guide${NC}            where to find this module's lab guide
    ${C_PROMPT}help${NC}             this list
    ${C_PROMPT}quit${NC}             leave the lab
EOF
    printf "\n"
}

teardown_prompt() {
    printf "\n"
    read -r -p "Shut down the lab machines before leaving? (y/N) " ans
    case "$ans" in
        # The --profile flag is REQUIRED. Every service in docker-compose.yml
        # belongs to a profile, and a bare `docker compose stop` does not select
        # profiled services: it exits 0, prints nothing, and stops NOTHING. Since
        # output goes to $LOGFILE, the student saw "Lab stopped." while containers
        # (m02-attacker with root+NET_RAW, the m07/m11 nodes with NET_ADMIN) kept
        # running — on a shared lab PC, across sessions. Verified on Compose v2.
        [Yy]*) ( cd "$PROJECT_ROOT" && "${COMPOSE[@]}" --profile "module-${MODULE_NO}" stop ) >"$LOGFILE" 2>&1
               if "$ENGINE" ps -q --filter "name=^m${MODULE_NO}-" | grep -q .; then
                   printf "${C_WARN}Some lab machines are still running. Use 'make down' to force them off.${NC}\n"
               else
                   printf "${C_OK}Lab stopped. Run ./start.sh to come back.${NC}\n"
               fi ;;
        *)     printf "${C_DIM}Lab left running. ./start.sh to return, or 'make stop' to halt it.${NC}\n" ;;
    esac
}

repl() {
    printf "\n${C_OK}Welcome%s.${NC} You are logged in.\n" "${ANALYST:+, $ANALYST}"
    topology
    if [ -n "${BROWSER_URL:-}" ]; then
        printf "\n${C_OK}This lab runs in your web browser.${NC}\n"
        printf "  Type ${C_PROMPT}open${NC} to launch it, or go to: ${C_TITLE}%s${NC}\n" "$BROWSER_URL"
    fi
    printf "\nType ${C_PROMPT}help${NC} for commands.\n\n"
    while true; do
        printf "${C_PROMPT}lab>${NC} "
        if ! read -r line; then break; fi
        # shellcheck disable=SC2086
        set -- $line
        local cmd="${1:-}"; [ $# -gt 0 ] && shift || true
        case "$cmd" in
            "")        : ;;
            open)      open_browser ;;
            url)       printf "  %s\n" "${BROWSER_URL:-<none>}" ;;
            connect|ssh) do_connect "${1:-}" ;;
            map)       topology ;;
            hosts)     printf "  %s\n" "$HOSTS" ;;
            guide)     printf "  %s\n" "$GUIDE_PATH" ;;
            help|\?)   show_help ;;
            quit|exit|logout) break ;;
            *)         module_dispatch "$cmd" "$@" || printf "${C_ERR}unknown command: %s${NC}  (type 'help')\n" "$cmd" ;;
        esac
    done
    teardown_prompt
}

# --- main ------------------------------------------------------------------
ANALYST="${1:-}"
MODULE_NO="$(choose_module)"
DESC="$(descriptor_for "$MODULE_NO")"
if [ -z "$DESC" ] || [ ! -f "$DESC" ]; then
    printf "${C_ERR}No such module: %s${NC}\n" "$MODULE_NO"
    printf "Available:\n"; list_modules | sed 's/|/  /'
    exit 1
fi
# shellcheck source=/dev/null
. "$DESC"
GUIDE_PATH="$(dirname "$DESC")/LAB-GUIDE.md"
GUIDE_PATH="${GUIDE_PATH#"$PROJECT_ROOT"/}"

# In GitHub Codespaces, the browser can't reach localhost — ports are forwarded to
# <codespace>-<port>.<domain>. Rewrite a module's BROWSER_URL to that forwarded URL.
# No effect locally (guarded by $CODESPACES).
if [ "${CODESPACES:-}" = "true" ] && [ -n "${BROWSER_URL:-}" ]; then
    _port=$(printf '%s' "$BROWSER_URL" | sed -E 's#.*:([0-9]+).*#\1#')
    BROWSER_URL="https://${CODESPACE_NAME}-${_port}.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN:-app.github.dev}"
fi

start_version_check   # backgrounded; result is read after the lab is up
banner
need_docker
if [ -z "$ANALYST" ] && [ -t 0 ]; then
    read -r -p "Enter your name (for the lab session): " ANALYST
fi
bring_up
report_if_stale
if [ -n "${SHELL_HOST:-}" ]; then
    enter_shell "$SHELL_HOST"
else
    repl
fi
